---
// src/pages/about.astro - Visibility Audits, about
// Static output: all copy is in the served HTML. No client JS.
const title = 'About | Visibility Audits';
const description = "Danny Pollack, founder of Visibility Audits: a measurement practice for how AI systems describe your company.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href="https://visibility-audits.com/about" />
    <meta property="og:title" content="About | Visibility Audits" />
    <meta property="og:description" content="Measuring how AI answer engines describe your company to the people deciding whether to buy from you." />
    <meta property="og:url" content="https://visibility-audits.com/about" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://visibility-audits.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
  <div style="background:#FFFFFF;">
    <header data-m="navbar" style="display:flex; align-items:center; justify-content:space-between; padding:26px 56px 0;">
      <a href="/" style="display:block; text-decoration:none;">
        <img src="/logo.svg" alt="Visibility Audits" style="width:37px; height:26px; display:block;">
      </a>
      <nav data-m="nav" style="display:flex; gap:6px; font-size:13px; font-weight:500;">
        <a href="/" class="nav-link" style="text-decoration:none; padding:8px 18px; border-radius:999px; color:#0D0D0D;">Home</a>
        <a href="/about" style="text-decoration:none; padding:8px 18px; border-radius:999px; background:#0D0D0D; color:#FFFFFF;">About</a>
        <a href="/research" class="nav-link" style="text-decoration:none; padding:8px 18px; border-radius:999px; color:#0D0D0D;">Research</a>
        <a href="/method" class="nav-link" style="text-decoration:none; padding:8px 18px; border-radius:999px; color:#0D0D0D;">Method</a>
      </nav>
    </header>
  
    <div data-m="pad" style="padding:0 56px;">
      <div data-m="masthead" style="display:grid; grid-template-columns:1fr 420px; gap:64px; align-items:center; padding:56px 0 0;">
        <div>
          <p style="margin:0 0 26px; font-size:11px; font-weight:500; letter-spacing:0.16em; text-transform:uppercase; color:#545454;">About</p>
          <p data-m="lead" style="margin:0 0 40px; font-size:24px; line-height:1.4; font-weight:300; letter-spacing:-0.01em; max-width:44ch; text-wrap:pretty;">I'm Danny, founder of Visibility Audits, a measurement practice for how AI systems describe your company to the people deciding whether to buy from you.</p>
          <h1 data-m="h1" style="margin:0 0 32px; font-size:64px; line-height:1.02; font-weight:700; letter-spacing:-0.03em;">Who I am</h1>
          <p data-m="body" style="margin:0 0 22px; font-size:19px; line-height:1.65; font-weight:400; max-width:62ch; text-wrap:pretty;">I'm Danny Pollack. I was a Product Manager at Meta, building ads measurement systems used by millions of advertisers. The hard part was never running the campaign. It was proving the campaign caused anything when there are so many variables at play. AI visibility has the same problem. A company that publishes content and sees more citations can't always say that the content did it. That's a question I find interesting and it's the one I've built my practice around.</p>
          <p data-m="body" style="margin:0 0 28px; font-size:19px; line-height:1.65; font-weight:700; max-width:62ch; text-wrap:pretty;">Separating the change you caused from the change that would have happened anyway is what turns a result into a repeatable strategy. Without it, you're guessing which work to repeat. With it, you know which levers move your numbers.</p>
          <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
            <p style="margin:0; display:inline-flex; align-items:center; background:linear-gradient(100deg,#F4F8A6,#CDBEEA); border-radius:999px; padding:10px 22px; font-size:15px; font-weight:500;">This field is called GEO, or generative engine optimization.</p>
            <a href="https://www.linkedin.com/in/dannypollack/" target="_blank" rel="noopener" aria-label="Danny Pollack on LinkedIn" title="LinkedIn" style="display:block; width:72px; height:72px; border-radius:50%; text-decoration:none; flex:0 0 72px;" class="li-btn">
              <img src="/logos/linkedin-app-icon.png" alt="" width="72" height="72" style="display:block; width:72px; height:72px; border-radius:50%;">
            </a>
          </div>
        </div>
        <figure data-m="portrait" style="margin:0; background:linear-gradient(160deg,#F4F8A6 0%,#DCD3EF 68%,#CDBEEA 100%); border-radius:28px; padding:22px; overflow:hidden;">
          <img src="/danny.jpg" alt="Danny Pollack, founder of Visibility Audits" style="display:block; width:100%; aspect-ratio:4 / 5; object-fit:cover; object-position:50% 30%; border-radius:18px;">
        </figure>
      </div>
  
      <div data-m="section" style="padding:96px 0 0;">
        <div data-m="split" style="display:grid; grid-template-columns:300px 1fr; gap:56px; align-items:start;">
          <div>
          <h2 data-m="h2" style="margin:0; font-size:40px; line-height:1.05; font-weight:700; letter-spacing:-0.025em;">How I ended up here</h2>
          <ol data-m="timeline" style="list-style:none; margin:40px 0 0; padding:0; display:flex; flex-direction:column; gap:0;">
            <li style="display:grid; grid-template-columns:84px 1fr; gap:20px;">
              <div style="display:flex; flex-direction:column; align-items:center; gap:8px;">
                <img src="/logos/spotify.svg" alt="Spotify logo" width="84" height="84" style="display:block; width:84px; height:84px; object-fit:contain; border-radius:14px;">
                <div aria-hidden="true" style="width:2px; flex:1; min-height:34px; background:linear-gradient(180deg,#F4F8A6,#EAEAC8);"></div>
              </div>
              <div style="padding-top:6px;">
                <h3 style="margin:0 0 4px; font-size:17px; font-weight:700; letter-spacing:-0.01em;">Spotify</h3>
                
              </div>
            </li>
            <li style="display:grid; grid-template-columns:84px 1fr; gap:20px;">
              <div style="display:flex; flex-direction:column; align-items:center; gap:8px;">
                <img src="/logos/meta.svg" alt="Meta logo" width="84" height="84" style="display:block; width:84px; height:84px; object-fit:contain; border-radius:14px;">
                <div aria-hidden="true" style="width:2px; flex:1; min-height:34px; background:linear-gradient(180deg,#DCD3EF,#CDBEEA);"></div>
              </div>
              <div style="padding-top:6px;">
                <h3 style="margin:0 0 4px; font-size:17px; font-weight:700; letter-spacing:-0.01em;">Meta</h3>
                
              </div>
            </li>
            <li style="display:grid; grid-template-columns:84px 1fr; gap:20px;">
              <div style="display:flex; flex-direction:column; align-items:center; gap:8px;">
                <img src="/logos/visibility-audits.svg" alt="Visibility Audits logo" width="84" height="84" style="display:block; width:84px; height:84px; object-fit:contain; border-radius:14px;">
                
              </div>
              <div style="padding-top:6px;">
                <h3 style="margin:0 0 4px; font-size:17px; font-weight:700; letter-spacing:-0.01em;">Visibility Audits</h3>
                
              </div>
            </li>
          </ol>
          </div>
          <div style="display:flex; flex-direction:column; gap:22px; max-width:70ch;">
            <p data-m="body" style="margin:0; font-size:19px; line-height:1.65; font-weight:400; text-wrap:pretty;">I spent six years at Meta trying to prove what actually influences a buyer. Then, in the lead-up to my daughter being born, I became one.</p>
            <p data-m="body" style="margin:0; font-size:19px; line-height:1.65; font-weight:400; text-wrap:pretty;">ChatGPT was handing me a confident shortlist of brands, and I was believing it. I got curious about where those answers came from and from which sources a recommendation was actually built on.</p><p data-m="body" style="margin:0; font-size:19px; line-height:1.65; font-weight:400; text-wrap:pretty;">So I went looking for who was measuring it. I found plenty of citation dashboards but not a huge amount of information on how to influence those dashboards.&nbsp;<br><br>That's what I do. Find out where you currently stand, fix what's keeping you out of the answer and prove which of it worked.</p>
            
          </div>
        </div>
      </div>
    </div>
  
    <div data-m="panel" style="margin:96px 56px 0; background:#0D0D0D; color:#FFFFFF; border-radius:28px; padding:60px 64px; display:grid; grid-template-columns:300px 1fr; gap:56px;">
      <h2 data-m="h2" style="margin:0; font-size:40px; line-height:1.05; font-weight:700; letter-spacing:-0.025em; color:#F4F8A6;">Who I work with</h2>
      <div style="display:flex; flex-direction:column; gap:22px; max-width:66ch;">
        <p data-m="body" style="margin:0; font-size:19px; line-height:1.65; font-weight:300; text-wrap:pretty;">Any company whose buyers research before they commit. Where the purchase is considered rather than impulsive.</p>
        <p data-m="body" style="margin:0; font-size:19px; line-height:1.65; font-weight:300; text-wrap:pretty;">I'm taking on a small number of clients while the practice is new, which means the work is mine rather than delegated, and the findings from it are what I publish. If that sounds like you, tell me your domain and I'll run the first pass.</p>
        <p style="margin:8px 0 0;"><a href="/#contact" style="color:#F4F8A6; font-size:15px; font-weight:500;">See where you stand</a></p>
      </div>
    </div>
  
    <footer data-m="footer" style="margin-top:72px; border-top:1px solid #E4E4E4; padding:26px 56px; display:flex; justify-content:space-between; font-size:13px; font-weight:300; color:#545454;">
      <span>Visibility Audits</span>
      <span>visibility-audits.com</span>
    </footer>
  </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #0d0d0d;
    --yellow: #f4f8a6;
    --lilac: #cdbeea;
    --grey: #545454;
  }
  body {
    margin: 0;
    background: #ffffff;
    color: var(--ink);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  a:hover { color: var(--grey); }
  a.nav-link { text-decoration: none; }
  a.nav-link:hover { background: var(--yellow); }
  a.li-btn:hover { opacity: 0.85; }

  @media (max-width: 1000px) {
    [data-m="masthead"] { grid-template-columns:1fr 300px !important; gap:40px !important; }
    [data-m="split"] { grid-template-columns:240px 1fr !important; gap:36px !important; }
    [data-m="panel"] { grid-template-columns:240px 1fr !important; gap:36px !important; }
    [data-m="h1"] { font-size:52px !important; }
  }
  @media (max-width: 820px) {
    [data-m="masthead"] { grid-template-columns:1fr !important; gap:32px !important; }
    [data-m="portrait"] { max-width:420px !important; }
    [data-m="split"] { grid-template-columns:1fr !important; gap:20px !important; }
    [data-m="panel"] { grid-template-columns:1fr !important; gap:24px !important; }
  }
  @media (max-width: 600px) {
    body { overflow-x:hidden; }
    [data-m="navbar"] { flex-direction:column !important; align-items:flex-start !important; gap:14px !important; padding:18px 20px 0 !important; }
    [data-m="nav"] { flex-wrap:wrap !important; gap:4px !important; }
    [data-m="pad"] { padding-left:20px !important; padding-right:20px !important; }
    [data-m="masthead"] { grid-template-columns:1fr !important; gap:28px !important; padding-top:34px !important; }
    [data-m="portrait"] { border-radius:18px !important; }
    [data-m="h1"] { font-size:40px !important; }
    [data-m="h2"] { font-size:28px !important; }
    [data-m="lead"] { font-size:19px !important; }
    [data-m="body"] { font-size:17px !important; }
    [data-m="section"] { padding-top:52px !important; }
    [data-m="split"] { grid-template-columns:1fr !important; gap:14px !important; }
    [data-m="timeline"] { margin-top:28px !important; }
    [data-m="panel"] { padding:34px 22px !important; border-radius:18px !important; margin-left:20px !important; margin-right:20px !important; }
    [data-m="footer"] { flex-direction:column !important; gap:6px !important; padding:22px 20px !important; }
  }
</style>
